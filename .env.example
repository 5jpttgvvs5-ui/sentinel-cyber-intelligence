APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://sentinel:change-me-local-only@postgres:5432/sentinel
